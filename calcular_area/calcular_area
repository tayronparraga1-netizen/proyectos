    largo = 90
    ancho = 78
    area_rectangulo = calcular_area(largo, ancho)
print("largo del rectangulo:", largo, "metros")
print("ancho del rectangulo:", ancho, "metros")
print("area del rectangulo:", area_rectangulo, "metros cuadrados")
      